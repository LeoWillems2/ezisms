# ─────────────────────────────────────────────────────────────────────────────
# Het statische deel van de Laravel-configuratie. Dit bestand belandt als .env
# in het image en bevat uitsluitend wat NOOIT per installatie verschilt.
#
# Alles wat wél per installatie verschilt komt uit de omgeving van de container
# en overschrijft wat hier staat. Dat werkt omdat Laravel de dotenv-repository
# immutable maakt (Illuminate\Support\Env::getRepository, Env.php:89): een
# variabele die al in de procesomgeving staat wordt niet door .env overschreven.
#
# Zet hier dus GEEN sleutel neer die in compose.yml onder `environment:` staat —
# dan lijkt hij hier ingesteld terwijl de omgeving hem overrulet, en dat leest
# als een leugen. Zie implementatie/00l-docker-stack.md §0.4.
#
# APP_KEY staat er ook niet in: die wordt bij de eerste start gegenereerd en in
# installatie/app_key bewaard (§0.5). Hem hier vastzetten zou betekenen dat elke
# installatie dezelfde sleutel heeft, en die versleutelt de 2FA-geheimen.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=EzISMS
APP_ENV=production
APP_DEBUG=false
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs gaan naar storage/logs op de hostmap en niet naar stdout: ze overleven de
# container en een auditor die om logging vraagt kijkt daar. Docker's logdriver
# roteert en verliest. LOG_LEVEL komt wél uit de omgeving.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null

# Versleutelt de sessie-payload in de opslag. Kost weinig en beschermt sessiedata
# at-rest. Hier en niet in env.voorbeeld: dit verschilt niet per installatie, en
# een sleutel die daar staat maar niet in de `environment:` van compose.yml
# bereikt de container helemaal niet. Precies dat was er tot 19-08-2026 aan de
# hand: het voorbeeldbestand zei `true` en de sessies stonden onversleuteld.
SESSION_ENCRYPT=true

# SESSION_SECURE_COOKIE staat hier NIET: die verschilt wél per installatie (een
# ISMS op kaal http kan geen secure-only cookie zetten) en wordt door de
# entrypoint uit het schema van APP_URL afgeleid. Zie compose.yml en tls.md.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_SCHEME=null
# Seconden per SMTP-poging. Laag houden: er wordt synchroon verzonden.
MAIL_TIMEOUT=10
MAIL_FROM_NAME="${APP_NAME}"

PANDOC_BIN=/usr/bin/pandoc

# De vijfde attribuutdimensie van de maatregelclassificatie. Aanzetten gaat
# uitsluitend via `php artisan isms:capaciteiten aan`, dat een eigen bronbestand
# inleest; met de hand op true zetten levert een actieve maar lege dimensie.
ISMS_CAPACITEITEN=false
