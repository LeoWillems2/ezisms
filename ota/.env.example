APP_NAME=EzISMS

# De naam van de organisatie waarvoor dit ISMS wordt gevoerd — iets anders dan
# APP_NAME hierboven, dat de naam van de software is. Verschijnt naast het logo
# in de zijbalk en in de kop van een schermkopie voor de auditor. Leeg laten mag:
# dan blijft die regel weg, want "Organisatie: —" in een auditdocument leest als
# een fout.
ORGANISATIE=""

# Het versienummer van deze installatie, gelijk aan de git-tag waaruit ze is
# gebouwd. Verschijnt achter de productnaam in de zijbalk.
#
# In een uitgerolde installatie hoeft dit niet: laat u het leeg, dan vullen
# deploy.sh en de Docker-entrypoint het uit het manifest van de release, en klopt
# het na een upgrade vanzelf. Vult u het wél in, dan wint uw waarde en
# waarschuwt het uitrollog als ze afwijkt van de tag die uitgerold wordt.
#
# In de git-werkkopie is er geen manifest; daar zet u hem met de hand bij het
# aanmaken van een tag (zie CLAUDE.md). Leeg laten mag altijd — dan blijft de
# vermelding weg, en dat is beter dan een nummer dat niet klopt.
APP_VERSION=

APP_ENV=local
#APP_ENV=production

# Tweefactorauthenticatie is verplicht (implementatie/01d). In een demo-omgeving
# zet u ISMS_2FA_AFDWINGEN=false: anders is de eerste handeling van elke
# bezoeker het koppelen van een authenticator-app aan een wegwerpaccount.
ISMS_2FA_AFDWINGEN=true
ISMS_2FA_RESPIJT_DAGEN=14

# De norm waarop deze installatie wordt ingericht (implementatie/00h).
#
# ALLEEN BIJ HET OPZETTEN. Deze waarde wordt één keer gelezen, door
# NormprofielSeeder, en daarna vastgelegd in de tabel `normprofiel`. Die tabel is
# vanaf dat moment de bron: hem hier later omzetten verandert niets meer. Dat is
# opzet — de SoA-beoordelingen gelden voor de norm waarop ze zijn gemaakt, dus
# van norm wisselen betekent de database opnieuw opbouwen
# (`php artisan migrate:fresh --seed`).
#
# Een onbekende waarde is een fout en geen terugval naar ISO; de seeder weigert
# dan te draaien.
#
#   iso27001  ISO/IEC 27001 met de 93 beheersmaatregelen van Bijlage A.
#   nen7510   De zorgnorm: dezelfde Bijlage A plus 8 zorgspecifieke maatregelen,
#             en zorgterminologie in de schaalteksten.
#   bio2      Baseline Informatiebeveiliging Overheid 2 (uitgave v1.3). Laat
#             Bijlage A volledig ongemoeid en hangt er een niveau ónder: 127
#             genummerde overheidsmaatregelen (118 geldend, 4 vervallen, 5
#             verplaatst), elk gekoppeld aan een beheersmaatregel en met een
#             eigen beoordeling naast de SoA-regel. Let op de aantekening
#             hieronder: de teksten van die verplichtingen worden niet
#             meegeleverd.
ISMS_NORM=iso27001
#ISMS_NORM=nen7510
#ISMS_NORM=bio2

# NIET EEN INSTELLING, maar een aantekening bij ISMS_NORM=bio2.
#
# Van de overheidsmaatregelen levert dit systeem alleen de structuur mee:
# nummers, de koppeling naar de beheersmaatregel, de status en de
# Cbw-reikwijdte. De verplichtingsteksten zelf niet — de BIO staat onder
# CC BY-NC-SA 4.0 en of het Cyberbeveiligingsbesluit die beperking opheft is een
# open juridische vraag. Zonder die teksten werkt alles, maar leest elke
# verplichting als "Dit ISMS levert bij deze overheidsmaatregel geen tekst mee."
#
# Heeft u de BIO2 zelf gedownload, dan haalt u de teksten er in één keer uit:
#
#     python3 ../scripts/genereer_overheidsmaatregelen_seed.py \
#         --bron=<BIO2-werkmap>.xlsx --met-tekst
#     php artisan isms:overheidsmaatregelen
#
# Dat schrijft database/seeders/data/overheidsmaatregel-teksten.json, dat
# gitignored is en door builddistr.sh geweigerd wordt — het hoort in uw
# installatie te blijven staan. Zie het kennisartikel "De normteksten invoeren".

# Valt deze organisatie onder de Cyberbeveiligingswet (NIS2)? Los van de norm
# hierboven: dat hangt af van sector en omvang (implementatie/08b). Staat dit op
# false, dan blijven de Cbw-meldtermijnen bij een incident buiten beeld; de
# AVG-termijn geldt altijd. Bij ISMS_NORM=bio2 hoort hier een bewuste keuze: de
# BIO geldt ook voor overheidsentiteiten die buiten de Cyberbeveiligingswet
# vallen, en dan is ze verplichtende zelfregulering.
ISMS_CBW_PLICHTIG=false

# De vijfde attribuutdimensie van de maatregelclassificatie (beveiligings-
# capaciteiten). Alleen zinvol als u de norm bezit: de waardenlijst én de
# toewijzing per maatregel staan alleen daarin, dus dit systeem levert ze niet
# mee. Zet hem NIET met de hand aan — dan is de dimensie actief maar leeg.
# Gebruik `php artisan isms:capaciteiten aan`; dat commando leest uw eigen
# bronbestand in en zet deze regel zelf om.
ISMS_CAPACITEITEN=false

APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# De database. MySQL 8 — het Docker-image draait 8.4, en dat is waarop getoetst
# wordt. Laravel heeft ook een `mariadb`-driver; die is hier niet beproefd.
#
# SQLITE IS BUITEN DE ONTWIKKELOMGEVING GEEN OPTIE. De testsuite draait er wél
# op (`phpunit.xml` zet `DB_DATABASE=:memory:`) en daar is het precies goed: geen
# server nodig, per test een verse database. Een installatie waar echt mee
# gewerkt wordt is iets anders:
#
#  - De uitrol eist `mysqldump`. `scripts/deploy.sh` en `deploy-docker.sh` maken
#    vóór élke migratie een volledige dump en weigeren te draaien als dat
#    commando ontbreekt. Op sqlite is er geen terugweg bij een mislukte upgrade.
#  - Migraties die MySQL-specifiek DDL nodig hebben slaan zichzelf op een andere
#    driver stilzwijgend over (bijvoorbeeld het versmallen van de `actie`-enum
#    op `audit_logregels`). Het schema is dan losser dan wat de code aanneemt,
#    en dat merkt u pas bij de gegevens die erin staan.
#  - Sqlite serialiseert schrijvers op één bestandsslot; met meerdere
#    php-fpm-processen levert dat "database is locked" op zodra er tegelijk
#    gewerkt wordt.
#
# De database moet vooraf bestaan, en met utf8mb4: de norm- en maatregelteksten
# bevatten diakrieten en aanhalingstekens die in latin1 stilzwijgend sneuvelen.
#
#     CREATE DATABASE ezisms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE USER 'ezisms'@'localhost' IDENTIFIED BY '……';
#     GRANT ALL PRIVILEGES ON ezisms.* TO 'ezisms'@'localhost';
#
# ALL PRIVILEGES en niet minder: de migraties maken en wijzigen tabellen, ook bij
# een upgrade.
#
# Wilt u meerdere normprofielen naast elkaar draaien, neem dan een database per
# profiel — `ISMS_NORM` wordt maar één keer gelezen, dus dat is de enige manier.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ezisms
DB_USERNAME=ezisms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Seconden per SMTP-poging. Laag houden: er wordt synchroon verzonden.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pad naar de pandoc-binary, voor de RTF-preview van beleidsdocumenten en voor
# de Word-versie van een schermkopie. Vereist pandoc >= 3.1.7 (de eerste versie
# met een RTF-lezer). Ontbreekt pandoc of is hij ouder, dan blijft die preview
# "niet beschikbaar" en kan een document alleen worden gedownload.
# PANDOC_BIN=/usr/bin/pandoc

VITE_APP_NAME="${APP_NAME}"

SESSION_SECURE_COOKIE=true
