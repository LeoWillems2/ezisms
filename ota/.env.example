APP_NAME=EzISMS

# De naam van de organisatie waarvoor dit ISMS wordt gevoerd — iets anders dan
# APP_NAME hierboven, dat de naam van de software is. Verschijnt naast het logo
# in de zijbalk en in de kop van een schermkopie voor de auditor. Leeg laten mag:
# dan blijft die regel weg, want "Organisatie: —" in een auditdocument leest als
# een fout.
ORGANISATIE=""

# Het versienummer van deze installatie, gelijk aan de git-tag waaruit ze is
# gebouwd. Verschijnt achter de productnaam in de zijbalk.
#
# In een uitgerolde installatie hoeft dit niet: laat u het leeg, dan vullen
# deploy.sh en de Docker-entrypoint het uit het manifest van de release, en klopt
# het na een upgrade vanzelf. Vult u het wél in, dan wint uw waarde en
# waarschuwt het uitrollog als ze afwijkt van de tag die uitgerold wordt.
#
# In de git-werkkopie is er geen manifest; daar zet u hem met de hand bij het
# aanmaken van een tag (zie CLAUDE.md). Leeg laten mag altijd — dan blijft de
# vermelding weg, en dat is beter dan een nummer dat niet klopt.
APP_VERSION=

APP_ENV=local
#APP_ENV=production

# Tweefactorauthenticatie is verplicht (implementatie/01d). In een demo-omgeving
# zet u ISMS_2FA_AFDWINGEN=false: anders is de eerste handeling van elke
# bezoeker het koppelen van een authenticator-app aan een wegwerpaccount.
ISMS_2FA_AFDWINGEN=true
ISMS_2FA_RESPIJT_DAGEN=14

# De norm waarop deze installatie wordt ingericht (implementatie/00h).
#
# ALLEEN BIJ HET OPZETTEN. Deze waarde wordt één keer gelezen, door
# NormprofielSeeder, en daarna vastgelegd in de tabel `normprofiel`. Die tabel is
# vanaf dat moment de bron: hem hier later omzetten verandert niets meer. Dat is
# opzet — de SoA-beoordelingen gelden voor de norm waarop ze zijn gemaakt, dus
# van norm wisselen betekent de database opnieuw opbouwen
# (`php artisan migrate:fresh --seed`).
#
# Een onbekende waarde is een fout en geen terugval naar ISO; de seeder weigert
# dan te draaien.
ISMS_NORM=iso27001
#ISMS_NORM=nen7510

# Valt deze organisatie onder de Cyberbeveiligingswet (NIS2)? Los van de norm
# hierboven: dat hangt af van sector en omvang (implementatie/08b). Staat dit op
# false, dan blijven de Cbw-meldtermijnen bij een incident buiten beeld; de
# AVG-termijn geldt altijd.
ISMS_CBW_PLICHTIG=false

# De vijfde attribuutdimensie van de maatregelclassificatie (beveiligings-
# capaciteiten). Alleen zinvol als u de norm bezit: de waardenlijst én de
# toewijzing per maatregel staan alleen daarin, dus dit systeem levert ze niet
# mee. Zet hem NIET met de hand aan — dan is de dimensie actief maar leeg.
# Gebruik `php artisan isms:capaciteiten aan`; dat commando leest uw eigen
# bronbestand in en zet deze regel zelf om.
ISMS_CAPACITEITEN=false

APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Seconden per SMTP-poging. Laag houden: er wordt synchroon verzonden.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pad naar de pandoc-binary, voor de RTF-preview van beleidsdocumenten en voor
# de Word-versie van een schermkopie. Vereist pandoc >= 3.1.7 (de eerste versie
# met een RTF-lezer). Ontbreekt pandoc of is hij ouder, dan blijft die preview
# "niet beschikbaar" en kan een document alleen worden gedownload.
# PANDOC_BIN=/usr/bin/pandoc

VITE_APP_NAME="${APP_NAME}"
